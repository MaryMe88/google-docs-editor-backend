# CORS: список разрешённых источников через запятую
# Пример: https://script.google.com,https://docs.google.com
CORS_ALLOWED_ORIGINS=https://script.google.com,https://docs.google.com

# API-ключи для провайдеров (опционально, но рекомендуется)
# PERPLEXITY_API_KEY=your_key
# OPENAI_API_KEY=your_key
# ANTHROPIC_API_KEY=your_key
# OPENROUTER_API_KEY=your_key

# ---------------------------------------------------------------------------
# Контекстный бюджет LLM
# ---------------------------------------------------------------------------

# Режим работы контекстного бюджета:
#   observe  — только логирование (без отклонения запросов)
#   cap      — ограничивать max_tokens, но не отклонять
#   enforce  — ограничивать и отклонять при недостатке места
LLM_CONTEXT_BUDGET_MODE=observe

# Глобальный safety margin (запас токенов, резервируемый для безопасности)
# Рекомендуемое значение: 1024 для большинства сценариев
LLM_CONTEXT_SAFETY_MARGIN=1024

# Контекстное окно для провайдеров (общие значения)
# Если не заданы, используются дефолты: 16384
OPENROUTER_CONTEXT_WINDOW=16384
OPENAI_CONTEXT_WINDOW=16384
ANTHROPIC_CONTEXT_WINDOW=16384
PERPLEXITY_CONTEXT_WINDOW=16384

# Специфичные для модели переопределения (опционально)
# Формат: {PROVIDER}_{MODEL_NAME}_CONTEXT_WINDOW
# Модель нормализуется: заменяются все небуквенно-цифровые символы на _
# Пример для модели "openrouter/auto":
# OPENROUTER_OPENROUTER_AUTO_CONTEXT_WINDOW=8192
#
# Пример для модели "gpt-4o-mini":
# OPENAI_GPT_4O_MINI_CONTEXT_WINDOW=16384

# ---------------------------------------------------------------------------
# Аутентификация API (X-API-Key)
# ---------------------------------------------------------------------------

# В production (ENV=production) этот ключ ОБЯЗАТЕЛЕН, иначе приложение не запустится.
# Значение должно быть задано через окружение (не в репозитории).
# Для локальной разработки (ENV=development) или тестов (PYTEST_RUNNING=true)
# ключ не требуется – включается soft-mode (пропуск проверки).
API_SECRET_KEY=your-super-secret-key-here

# Режим окружения: development, production (по умолчанию production)
ENV=development