      "examples": [
        {
          "pattern": "осуществлять",
          "suggestions": ["делать", "проводить", "выполнять"]
        },
        {
          "pattern": "в целях",
          "suggestions": ["чтобы", "для"]
        }
      ]
    },
    {
      "id": "cliche",
      "name": "штампы",
