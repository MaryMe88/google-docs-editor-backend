      "severity": "rewrite",
      "examples": [
        {
          "pattern": "для того чтобы",
          "suggestions": ["чтобы"]
        }
      ]
    },
    {
      "id": "weak_verbs",
      "name": "слабые глаголы",
      "description": "Кандидаты на замену в информационных и деловых текстах, но не универсально 'запрещённые' глаголы; 'быть' и 'являться' часто незаменимы.",
      "severity": "flag",
